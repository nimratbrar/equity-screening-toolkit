    "capiq": {
      "enabled": false,
      "file": "inputs/capiq_export.xlsx",
      "sheet": 0,
      "header_row": 0,
      "column_map": {
        "ISIN": "isin",
        "Ticker": "ticker"
      }
    },
    "industry": {
      "enabled": false,
      "file": "inputs/industry_figures.csv"
    }
  }
