{
  "name": "watchlist_deepdive",
  "region": "global",
  "universe": {
    "min_market_cap": 1000
  },
  "custom_metrics": {
    "capex_to_da": "capx / dp"
  },
  "analysis": {
    "history_years": 10,
    "peer_level": "gsubind",
    "min_peers": 5,
    "names": [
      "JP3270000007",
      "JP3201600008",
      "FI0009004824",
      "XYL",
      "VLTO",
      "JP3371200001"
